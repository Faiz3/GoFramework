APP_NAME=GoFramework
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_PORT=3000
APP_READ_TIMEOUT=10s
APP_WRITE_TIMEOUT=10s
APP_BODY_LIMIT=10

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=forge
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=file
CACHE_PREFIX=go_cache

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_COOKIE=go_session

MAIL_DRIVER=smtp
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=app@localhost
MAIL_FROM_NAME=GoFramework
